PORT=5001
NODE_ENV=development
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/nexora?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173

# Optional persistent avatar directory on the host
# UPLOAD_DIR=/var/data/nexora-uploads
